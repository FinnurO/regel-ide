<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MysticMind.PostgresEmbed" Version="4.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RegelIde.Data\RegelIde.Data.csproj" />
    <ProjectReference Include="..\RegelIde.TestInfrastruktur\RegelIde.TestInfrastruktur.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\kilder\raw-lovdata\*.html">
      <Link>Testdata\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\data\kilder\raw-handbok\*.txt">
      <Link>Testdata\Handbok\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\data\kilder\raw-nettside\*.txt">
      <Link>Testdata\Nettside\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ekte fixtures for AltinnRessursHenter/AltinnSkjemaoversiktHenter (feature/altinn-hostere), allerede
         committet direkte i dette prosjektets egen Testdata-mappe (ikke under data/kilder/ som fixturene
         over) — samme CopyToOutputDirectory-mønster som RegelIde.Kildekonvertering.Tests' Testdata\Xsd\*.xsd. -->
    <None Include="Testdata\AltinnHosting\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ekte 5-rads utvalg for TjenestelisteImporter/Statsforvalter (feature/statsforvalter-tjenester-hoster),
         trimmet fra Johanns ekte ~288-rads produksjonsuttrekk — samme mønster som Testdata\AltinnHosting. -->
    <None Include="Testdata\StatsforvalterHosting\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ekte 4-rads utvalg for TjenestelisteImporter/FylkeskommuneDialog (feature/generaliser-tjenesteliste-importer),
         trimmet fra Johanns ekte ~655-rads produksjonsuttrekk — samme mønster som Testdata\StatsforvalterHosting. -->
    <None Include="Testdata\FylkeskommuneDialogHosting\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ekte 3-kommune/9-rads utvalg for KommuneTjenesteHenter (feature/kommune-tjenester-hoster), trimmet fra
         Johanns ekte ~15 332-rads produksjonsuttrekk — inkluderer bevisst den ekte Herøy-url-kollisjonen
         (to distinkte kommuner, samme url-mønster), se KommuneTjenesteHenter.cs klassekommentar. -->
    <None Include="Testdata\KommuneTjenesteHosting\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.973" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <!-- Npgsql 10.0.3 tillater [10.0.4, 11.0.0) og drar inn 10.0.4 transitivt, mens
         EF Core over er på 10.0.10. Uten denne eksplisitte referansen ender de to på
         hver sin versjon og bygget gir MSB3277-konflikt. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RegelIde.Kildekonvertering\RegelIde.Kildekonvertering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- (2026-08-28) Lar RegelIde.Data.Tests referere internal GyldigeX-kodelistene direkte (f.eks.
         fra TjenesteModellSkjemaTests, som verifiserer at det genererte JSON Schema-et aldri driver
         fra disse) — i stedet for å duplisere verdiene i testkoden og risikere at duplikatet selv
         drifter fra sannheten. -->
    <InternalsVisibleTo Include="RegelIde.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kopi av Johanns kommune-/fylkeskommune-eksport (Brønnøysundregisteret), committet slik at
         OrganisasjonsregisterSeed er reproduserbar uten å lese fra Downloads ved kjøretid. -->
    <None Include="Seed\organisasjoner-norge.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- [Ny, issue #311] Brreg-øyeblikksbilde for Stortinget (hentet 2026-10-07). Migrasjonen
         InnforStrukturkanttabell kan ikke gjøre nettverkskall; StrukturkantMigreringTests leser fila og
         sjekker at verdiene i StrukturkantMigrering.OrganSql er de samme. -->
    <None Include="Seed\brreg-971524960-stortinget.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- [Ny, issue #312] Områderegisterets øyeblikksbilder (OmraderegisterKilder.Alle). Fornyes med
         Seed/fornye-omraderegister.py, aldri ved oppstart (CLAUDE.md §4). -->
    <None Include="Seed\kartverket-fylker-kommuner.json;Seed\brreg-kommuner.json;Seed\brreg-domstoler.json;Seed\kartverket-ssr-rettssteder.json;Seed\ssb-klass-104-fylkesendringer-2024.json;Seed\statsforvalter-embetsomrader.json;Seed\helseregioner-rhf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

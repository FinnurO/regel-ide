<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- [Ny, 2026-08-28] Samme begrunnelse som RegelIde.Data.Tests.csproj — ekskluder de tre
         Import_fra_lovdata_*-testene i ImportEndepunktTests.cs (Category=LiveIntegration, ekte
         nettverkskall mot lovdata.no) fra en vanlig `dotnet test`. Overstyr med
         `dotnet test -p:VSTestTestCaseFilter="Category=LiveIntegration"` for en bevisst "ekte
         Lovdata"-kjøring. -->
    <VSTestTestCaseFilter Condition=" '$(VSTestTestCaseFilter)' == '' ">Category!=LiveIntegration</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MysticMind.PostgresEmbed" Version="4.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RegelIde.Api\RegelIde.Api.csproj" />
    <ProjectReference Include="..\RegelIde.Data\RegelIde.Data.csproj" />
    <ProjectReference Include="..\RegelIde.TestInfrastruktur\RegelIde.TestInfrastruktur.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\kilder\raw-lovdata\*.html">
      <Link>Testdata\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "regel-ide-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/RegelIde.Api"],
      "port": 5187
    },
    {
      "name": "regel-ide-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/RegelIde.Web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "nettside-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8123", "--directory", "nettside"],
      "port": 8123
    }
  ]
}
